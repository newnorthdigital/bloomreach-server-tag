const getAllEventData = require('getAllEventData');
const getCookieValues = require('getCookieValues');
const setCookie = require('setCookie');
const getRemoteAddress = require('getRemoteAddress');
const getRequestHeader = require('getRequestHeader');
const sendHttpGet = require('sendHttpGet');
const encodeUriComponent = require('encodeUriComponent');
const generateRandom = require('generateRandom');
const getTimestampMillis = require('getTimestampMillis');
const makeString = require('makeString');
const makeInteger = require('makeInteger');
const makeTableMap = require('makeTableMap');
const getType = require('getType');
const Object = require('Object');
const logToConsole = require('logToConsole');

const ENDPOINT = 'https://p.brsrvr.com/pix.gif';
const COOKIE = '_br_uid_2';
// Bloomreach's server-side guide asks for a version prefixed with "ss-".
const VERSION = 'ss-nnd-1.0';
// Bloomreach's guide lists these user agents as ones to keep out. "bot" only
// counts when followed by a separator (Googlebot/2.1, AdsBot-Google), so phone
// models like CUBOT are not dropped.
const UA_BLOCKLIST = ['curl', 'wget', 'python-requests', 'postmanruntime', 'java/', 'node-fetch', 'axios', 'spider', 'crawler',
  'bot/', 'bot;', 'bot)', 'bot-', 'bot+'];

const pixelType = data.pixelType || 'pageview';
const accountId = data.accountId ? makeString(data.accountId) : '';

// Errors always reach production logs; verbose per-event logs only when enabled.
const logError = (msg) => logToConsole('Bloomreach sGTM - ERROR - ' + msg);
const logInfo = (msg) => {
  if (data.consoleLog) {
    logToConsole('Bloomreach sGTM - ' + msg);
  }
};

const isSet = (v) => v !== undefined && v !== null && makeString(v) !== '';
const firstSet = (a, b) => isSet(a) ? a : b;

// Read the event once and work from the snapshot.
const ev = getAllEventData() || {};
const items = getType(ev.items) === 'array' ? ev.items : [];

// Map one item (GA4 or Bloomreach shape) to prod_id/sku/name/quantity/price.
// In GA4 item_id is either the product ID or the SKU; idMapping says which.
const mapItem = (item) => {
  const out = {};
  if (getType(item) !== 'object') {
    return out;
  }
  if (isSet(item.prod_id)) {
    out.prod_id = makeString(item.prod_id);
    out.sku = isSet(item.sku) ? makeString(item.sku) : '';
  } else if (data.idMapping === 'sku') {
    out.prod_id = makeString(firstSet(item.item_group_id, item.item_id));
    out.sku = isSet(item.item_id) ? makeString(item.item_id) : '';
  } else {
    out.prod_id = isSet(item.item_id) ? makeString(item.item_id) : '';
    out.sku = '';
  }
  out.name = makeString(firstSet(item.name, firstSet(item.item_name, '')));
  out.quantity = makeString(firstSet(item.quantity, 1));
  out.price = isSet(item.price) ? makeString(item.price) : '';
  return out;
};

// Bloomreach's API basket format: !i<prod_id>'s<sku>'n<name>'q<qty>'p<price>
// per item. Like br-trk, ! and ' inside values become %21/%27 so they cannot
// act as separators, and the whole basket is URL-encoded once more when sent.
const encodeBasketValue = (v) => makeString(v).split("'").join('%27').split('!').join('%21');
const buildBasket = () => {
  const source = isSet(data.basketItems) ? data.basketItems : items;
  if (getType(source) !== 'array') {
    return '';
  }
  let out = '';
  source.forEach((raw) => {
    const it = mapItem(raw);
    if (!it.prod_id) {
      return;
    }
    out += '!i' + encodeBasketValue(it.prod_id);
    if (it.sku) {
      out += "'s" + encodeBasketValue(it.sku);
    }
    out += "'n" + encodeBasketValue(it.name) + "'q" + encodeBasketValue(it.quantity) + "'p" + encodeBasketValue(it.price);
  });
  return out;
};

// "products_en, content_en" -> "cat0=products_en!cat1=content_en" (native API format)
const buildCatalogs = (v) => {
  if (!isSet(v)) {
    return undefined;
  }
  const names = [];
  makeString(v).split(',').forEach((n) => {
    if (n.trim()) {
      names.push(n.trim());
    }
  });
  return names.map((n, i) => 'cat' + i + '=' + n).join('!');
};

// Consent: GA4 sends gcs as G1<ad_storage><analytics_storage>. A 0 in the
// analytics position means analytics_storage was denied in the browser.
const analyticsDenied = () => {
  const gcs = ev['x-ga-gcs'];
  return getType(gcs) === 'string' && gcs.length >= 4 && gcs.charAt(3) === '0';
};

// Visitor cookie. Reuses an existing _br_uid_2 (set by the browser tracker or
// by this tag) so users keep their history, creates one when missing, and bumps
// the hit count on every hit, as Bloomreach requires.
const nextCookie = () => {
  const raw = getCookieValues(COOKIE)[0];
  let uid = '';
  const fields = {};
  if (raw) {
    const parts = raw.split(':');
    if (parts[0].indexOf('uid=') === 0) {
      uid = parts[0].substring(4);
    }
    for (let i = 1; i < parts.length; i++) {
      const kv = parts[i].split('=');
      if (kv[0] && kv[1]) {
        fields[kv[0]] = kv[1];
      }
    }
  }
  if (!uid) {
    uid = makeString(generateRandom(1000000000000, 9999999999999));
    logInfo('New visitor, generated uid ' + uid);
  }
  fields.v = fields.v || VERSION;
  fields.ts = fields.ts || makeString(getTimestampMillis());
  fields.hc = makeString((makeInteger(fields.hc) || 0) + 1);
  const parts = ['uid=' + uid];
  Object.keys(fields).forEach((k) => parts.push(k + '=' + fields[k]));
  return parts.join(':');
};

const PAGE_TYPES = ['pageview', 'virtualPageview'];
const EVENTS = {
  addToCart: {group: 'cart', etype: 'click-add'},
  quickView: {group: 'product', etype: 'quickview'},
  searchSubmit: {group: 'suggest', etype: 'submit'},
  suggestClick: {group: 'suggest', etype: 'click'}
};

if (!accountId) {
  logError('Account ID is required');
  data.gtmOnFailure();
  return;
}
if (PAGE_TYPES.indexOf(pixelType) === -1 && !EVENTS[pixelType]) {
  logError('Unknown pixel type ' + pixelType);
  data.gtmOnFailure();
  return;
}
if (data.respectConsent !== false && analyticsDenied()) {
  logInfo('Skipped: analytics_storage denied (gcs ' + ev['x-ga-gcs'] + ')');
  data.gtmOnSuccess();
  return;
}

const userAgent = makeString(firstSet(ev.user_agent, firstSet(getRequestHeader('user-agent'), '')));
const uaLower = userAgent.toLowerCase();
const isBlocked = UA_BLOCKLIST.some((b) => uaLower.indexOf(b) !== -1) ||
  (uaLower.length >= 3 && uaLower.substring(uaLower.length - 3) === 'bot');
if (!userAgent || isBlocked) {
  logInfo('Skipped: missing or blocklisted user agent "' + userAgent + '"');
  data.gtmOnSuccess();
  return;
}

const cookie2 = nextCookie();
setCookie(COOKIE, cookie2, {
  domain: 'auto',
  path: '/',
  'max-age': 34560000,
  secure: true,
  sameSite: 'lax',
  httpOnly: false
});

const pageUrl = firstSet(data.pageUrl, ev.page_location);
const params = {
  acct_id: accountId,
  cookie2: cookie2,
  rand: makeString(generateRandom(1, 2147483647)),
  version: VERSION,
  client_ts: makeString(getTimestampMillis() * 1000),
  client_ip: makeString(firstSet(ev.ip_override, getRemoteAddress())),
  url: pageUrl,
  ref: firstSet(data.referrer, ev.page_referrer),
  title: firstSet(data.title, ev.page_title),
  lang: ev.language,
  domain_key: data.domainKey,
  view_id: data.viewId,
  user_id: data.userId
};
if (data.testData) {
  params.test_data = 'true';
}
if (data.debugMode) {
  params.debug = 'true';
}

let basket = '';
if (PAGE_TYPES.indexOf(pixelType) !== -1) {
  const ptype = makeString(data.ptype || 'other');
  params.type = 'pageview';
  params.ptype = ptype;
  if (pixelType === 'virtualPageview') {
    params.orig_ref_url = pageUrl;
  }
  if (ptype === 'product') {
    const item = mapItem(items[0]);
    params.prod_id = firstSet(data.prodId, item.prod_id);
    params.prod_name = firstSet(data.prodName, item.name);
    params.sku = firstSet(data.sku, item.sku);
  } else if (ptype === 'category') {
    params.cat_id = data.catId;
    params.cat = data.cat;
  } else if (ptype === 'search') {
    params.search_term = firstSet(data.searchTerm, ev.search_term);
  } else if (ptype === 'content') {
    params.item_id = data.itemId;
    params.item_name = data.itemName;
  } else if (ptype === 'conversion') {
    params.is_conversion = '1';
    params.order_id = firstSet(data.orderId, ev.transaction_id);
    params.basket_value = firstSet(data.basketValue, ev.value);
    params.currency = firstSet(data.currency, ev.currency);
    basket = buildBasket();
  }
  if (ptype === 'search' || ptype === 'content') {
    params.catalogs = buildCatalogs(data.catalogs);
  }
} else {
  const evt = EVENTS[pixelType];
  params.type = 'event';
  params.ptype = 'event';
  params.group = evt.group;
  params.etype = evt.etype;
  if (pixelType === 'addToCart' || pixelType === 'quickView') {
    const item = mapItem(items[0]);
    params.prod_id = firstSet(data.evProdId, item.prod_id);
    params.sku = firstSet(data.evSku, item.sku);
    params.prod_name = firstSet(data.evProdName, item.name);
    if (pixelType === 'addToCart') {
      params.price = item.price;
      params.quantity = item.quantity;
    }
  } else {
    params.q = firstSet(data.query, ev.search_term);
    if (pixelType === 'suggestClick') {
      params.aq = data.typedQuery;
    }
    params.catalogs = buildCatalogs(data.catalogs);
  }
}

if (data.extraParams && data.extraParams.length) {
  const extra = makeTableMap(data.extraParams, 'key', 'value') || {};
  const RESERVED = ['acct_id', 'cookie2', 'rand', 'version', 'client_ts', 'client_ip', 'type', 'ptype', 'group', 'etype', 'basket', 'is_conversion'];
  Object.keys(extra).forEach((k) => {
    if (RESERVED.indexOf(k) === -1) {
      params[k] = extra[k];
    }
  });
}

const query = [];
Object.keys(params).forEach((k) => {
  if (isSet(params[k])) {
    query.push(encodeUriComponent(k) + '=' + encodeUriComponent(makeString(params[k])));
  }
});
if (basket) {
  query.push('basket=' + encodeUriComponent(basket));
}
const url = ENDPOINT + '?' + query.join('&');
logInfo('Sending ' + params.type + ' (' + (params.etype || params.ptype) + '): ' + url);

// Promise-based sends time out after 5 seconds in the sandbox, so stay under it.
sendHttpGet(url, {headers: {'user-agent': userAgent}, timeout: 4000}).then((result) => {
  if (result.statusCode >= 200 && result.statusCode < 400) {
    logInfo('Sent, status ' + result.statusCode);
    data.gtmOnSuccess();
  } else {
    logError('Pixel rejected, status ' + result.statusCode + ' for ' + (params.etype || params.ptype));
    data.gtmOnFailure();
  }
}, (err) => {
  logError('Pixel request failed: ' + (err && err.reason));
  data.gtmOnFailure();
});


